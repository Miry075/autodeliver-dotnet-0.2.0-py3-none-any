# autodeliver for this repository. Generated by `autodeliver init` (autodeliver {version}).
# Queue manually with a work item id, or let the schedule pick the oldest item tagged 'auto-deliver'.
trigger: none
pr: none

schedules:
  - cron: "0 6 * * 1-5"
    displayName: autodeliver dispatcher
    branches:
      include: [{target_branch}]
    always: true

parameters:
  - name: workItemId
    displayName: Work item id (0 = next tagged item)
    type: number
    default: 0
  - name: dryRun
    displayName: Dry run (no push, no PR, no work item writes)
    type: boolean
    default: false

resources:
  repositories:
    - repository: autodeliver          # the autodeliver tool repository, pinned to a release tag
      type: git
      name: {tool_repo}
      ref: refs/tags/v{version}

jobs:
  - template: azure-pipelines/templates/autodeliver-job.yml@autodeliver
    parameters:
      workItemId: ${{{{ parameters.workItemId }}}}
      dryRun: ${{{{ parameters.dryRun }}}}
      pool:
        vmImage: ubuntu-latest           # windows-latest also works
