# Safety lists (scope.deny_paths, scope.dependency_files, phi.blocking_identifiers, ...) are additive:
# entries here are added to the defaults, never replace them.

azure_devops:
  organization_url: {organization_url}
  project: {project}
  repository: {repository}
  target_branch: {target_branch}
