{
  "type": "object",
  "properties": {
    "ac_classification": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ac_id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "existing",
              "additional",
              "uncertain",
              "deferred"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "ac_id",
          "kind",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "change": {
            "type": "string",
            "enum": [
              "create",
              "modify",
              "delete"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "change",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "concerns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "impact": {
            "type": "string",
            "enum": [
              "negligible",
              "minor",
              "material"
            ]
          },
          "impact_reason": {
            "type": "string"
          },
          "default": {
            "type": "string"
          },
          "reversible": {
            "type": "boolean"
          }
        },
        "required": [
          "question",
          "why",
          "impact",
          "impact_reason",
          "default",
          "reversible"
        ],
        "additionalProperties": false
      }
    },
    "assumption_review": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A-[0-9]+$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "accept",
              "escalate"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "verdict",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ac_classification",
    "files",
    "concerns",
    "blockers",
    "assumption_review"
  ],
  "additionalProperties": false
}