        "type": "object",
        "properties": {
          "ac_id": {
            "type": "string",
            "pattern": "^(AC|SC)-[0-9]+$"
          },
          "met": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "ac_id",
          "met",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
