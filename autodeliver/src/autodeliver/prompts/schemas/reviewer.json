      "type": "string",
      "enum": [
        "APPROVE",
        "CHANGES_REQUESTED"
      ]
    },
    "existing_ac_assessment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ac_id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "holds": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "ac_id",
          "holds",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "ac_assessment": {
      "type": "array",
